<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Megaraz.ResultPattern</PackageId>
    <Version>0.2.2</Version>
    <Title>Megaraz Result Pattern</Title>
    <Description>A focused Result Pattern library for .NET.</Description>
    <Authors>Megaraz</Authors>
    <Copyright>Copyright (c) 2026 Megaraz</Copyright>
    <RepositoryUrl>https://github.com/Megaraz/Megaraz.ResultPattern</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Megaraz/Megaraz.ResultPattern</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>result;result-pattern;errors;validation</PackageTags>
    <PackageReleaseNotes>0.2.2: Combines the pending post-0.2.1 maintenance changes: validation and error-context invariant fixes, clearer validation and security documentation, package metadata and release-version validation, portable symbol packages, Source Link and package-content verification, CI artifact retention, and immutable GitHub Actions pins. The boolean validation out-parameter nullable annotations remain unchanged from 0.2.1 for source compatibility; their values are meaningful only when the method returns true.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
